# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/
**/secrets/

# OS / editor
.DS_Store
.idea/
.vscode/

# Personal assets (biometric photo etc.) — local-only, never in git history
# even though this repo is private.
/domain/assets/

# Generated outputs (Phase 2+)
/output/
/out/
/out/cv_passed/
/out/cv_watchlist/
/applications/
*.pdf

# Tailored CV drafts (cv-tailor skill output) — personal application content,
# local-only like the other generated outputs above.
/cv-output/

# Per-user onboarding profiles (created via /onboarding) — real personal data
# (CV, salary expectations, excluded companies) for anyone who forks this repo.
# Ignored by default so a fork on a PUBLIC GitHub repo doesn't accidentally
# commit/push someone's personal data (see README "Forken und selbst nutzen").
/profiles/*
!/profiles/.gitkeep
